NODE_ENV=development
PORT=3000
REDIS_LOCAL=false

# Cryptography Keys
HTOTP_MASTER_KEY=your-secure-master-key-here
HTOTP_TOKEN_SIGNING_KEY=your-secure-token-signing-key-here
HTOTP_SESSION_SIGNING_KEY=your-secure-session-signing-key-here

# Time & Rules
TOTP_TIME_STEP=30
MAX_OTP_ATTEMPTS=3
OTP_DIGITS=6
OTP_VALIDITY_SECONDS=120

# Notifications
EMAIL_PROVIDER=mock # Options: mock, smtp
SMS_PROVIDER=mock   # Options: mock
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com
